{
  "schemaVersion": "1.1",
  "project": {
    "id": "my-project",
    "displayName": "My project"
  },
  "source": {
    "root": "SOURCE_ROOT",
    "caseSensitive": true,
    "symlinks": "reject"
  },
  "destination": {
    "provider": "google-drive",
    "accountRef": "ACCOUNT_REFERENCE",
    "rootFolderId": "DESTINATION_FOLDER_ID",
    "namespaceMode": "app-managed"
  },
  "filters": {
    "composition": "conservative",
    "gitMode": "patterns-only",
    "defaultDecision": "include",
    "failOnError": true,
    "groups": [
      {
        "id": "git",
        "priority": 100,
        "enabled": true,
        "dialect": "gitignore",
        "scope": "project",
        "sources": [
          {
            "type": "recursive-basename",
            "value": ".gitignore",
            "required": false
          }
        ]
      }
    ]
  },
  "sync": {
    "mode": "copy",
    "approvalPolicy": "interactive",
    "conflictPolicy": "keep-both",
    "overwritePolicy": "deny",
    "verification": "content-hash",
    "maxTransfers": 4,
    "maxRetries": 6,
    "maxDeleteCount": 0,
    "maxDeletePercent": 0
  },
  "automation": {
    "enabled": false,
    "trigger": "manual",
    "intervalSeconds": 0
  }
}
